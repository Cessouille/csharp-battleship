<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Permet à BattleShip.Tests de réutiliser des règles internes (ex. ProbabilityTargeting.PlayedCells) au
         lieu de les recopier dans des doublures de test qui pourraient diverger silencieusement. -->
    <InternalsVisibleTo Include="BattleShip.Tests" />
  </ItemGroup>

</Project>
