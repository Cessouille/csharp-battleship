@page "/game/{GameId:guid}"
@inject HttpClient Http
@inject BattleShip.Grpc.Battleship.BattleshipClient GrpcClient
@inject NavigationManager Navigation
@using System.Net
@using System.Net.Http.Json
@using BattleShip.App.Components
@using BattleShip.App.Game
@using BattleShip.Models.Contracts
@using BattleShip.Models.Domain
@using global::BattleShip.Grpc
@using global::Grpc.Core

<PageTitle>Partie en cours</PageTitle>

@if (_notFound)
{
    <div class="alert alert-warning">
        Partie introuvable. <a href="/">Retour à l'accueil</a>.
    </div>
}
else if (_state is null)
{
    <p>Chargement…</p>
}
else
{
    <GameStatusBanner Status="@_state.Status" Winner="@_state.Winner" Hint="@Hint" OnNewGame="GoHomeAsync" />

    @if (_newlyUnlocked.Count > 0)
    {
        <AchievementToast AchievementIds="_newlyUnlocked" OnDismiss="() => _newlyUnlocked = []" />
    }

    @if (_state.Status == "InProgress")
    {
        <ActionBar State="_state" Mode="_mode" ModeChanged="SetMode"
                   @bind-TorpedoEdge="_torpedoEdge" @bind-StrikeOrientation="_strikeOrientation"
                   SelectionCount="_selection.Count" Busy="_busy" FireSalvo="FireSalvoAsync" />
    }

    @if (_moveError is not null)
    {
        <div class="alert alert-danger">@_moveError</div>
    }

    @if (_state.PendingChallenge is { } challenge)
    {
        <TimingChallenge @key="challenge.ChallengeId" Challenge="challenge" OnStop="OnChallengeStopAsync" />
    }

    @if (_state.Status == "InProgress" && _state.PendingChallenge is null)
    {
        <form class="d-flex align-items-center gap-2 mb-2" @onsubmit="SubmitTargetCodeAsync">
            <label for="target-code" class="form-label mb-0 small">Case cible</label>
            <input id="target-code" class="form-control form-control-sm" style="max-width:6rem"
                   placeholder="ex. B5" @bind="_targetCode" @bind:event="oninput" disabled="@_busy" />
            <button type="submit" class="btn btn-sm btn-outline-primary" disabled="@_busy">Viser</button>
        </form>
    }

    <div class="row">
        <div class="col-auto">
            <h2 class="h5">Votre plateau</h2>
            <BoardGrid Size="_state.MyBoard.Size" Cells="_state.MyBoard.ToGrid()" Interactive="false" />
            <FleetLegend Entries="FleetLegend.FromShips(_state.MyBoard.Ships)" />
        </div>
        <div class="col-auto">
            <h2 class="h5">Plateau adverse</h2>
            <BoardGrid Size="_state.OpponentBoard.Size" Cells="_state.OpponentBoard.ToGrid()"
                       Interactive="@(_state.Status == "InProgress" && !_busy && _state.PendingChallenge is null)" CanClick="CanClick"
                       Selected="_selection" OnCellClick="OnOpponentCellClickAsync" />
            <FleetLegend Entries="FleetLegend.FromOpponentView(_state.OpponentBoard.SunkShips)" />
        </div>
    </div>

    @if (_state.Achievements.Count > 0)
    {
        <div class="mb-3">
            <h2 class="h6">Succès de cette partie</h2>
            <p class="small">Voir <a href="mes-succes">Mes succès</a> pour l'ensemble de vos succès, toutes parties confondues.</p>
            <div class="row row-cols-1 row-cols-md-2 g-2">
                @foreach (var id in _state.Achievements)
                {
                    @if (AchievementCatalog.Find(id) is { } info)
                    {
                        <div class="col">
                            <AchievementBadge Info="info" Unlocked="true" />
                        </div>
                    }
                }
            </div>
        </div>
    }

    @if (_state.History.Count > 0)
    {
        <div class="mb-3">
            <h2 class="h6">Journal de partie</h2>
            <ul class="small">
                @for (var i = 0; i < _state.History.Count; i++)
                {
                    var turnNumber = i + 1;
                    var entry = _state.History[i];
                    <li>@DescribeEntry(turnNumber, entry)</li>
                }
            </ul>
        </div>
    }
}

@code {
    [Parameter] public Guid GameId { get; set; }

    private GameStateDto? _state;
    private ActionMode _mode = ActionMode.Shot;
    private Edge _torpedoEdge = Edge.Left;
    private Orientation _strikeOrientation = Orientation.Horizontal;
    private readonly HashSet<(int Row, int Column)> _selection = [];
    private string _targetCode = "";
    private bool _notFound;
    private bool _busy;
    private string? _moveError;
    private IReadOnlyList<string> _newlyUnlocked = [];

    private bool IsSalvo => _state?.Options.ShotMode == nameof(ShotMode.Salvo);

    private string Hint => _mode switch
    {
        ActionMode.Scan => "cliquez le coin haut-gauche de la zone 2×2 à scanner.",
        ActionMode.Torpedo => _torpedoEdge is Edge.Left or Edge.Right
            ? "cliquez une case de la ligne où lancer la torpille."
            : "cliquez une case de la colonne où lancer la torpille.",
        ActionMode.AirStrike => "cliquez la première des 3 cases de la frappe.",
        _ when IsSalvo => $"sélectionnez {_state!.Actions.SalvoSize} cases puis tirez la salve.",
        _ => "cliquez une case de la grille adverse pour tirer."
    };

    protected override Task OnParametersSetAsync() => LoadStateAsync();

    private async Task LoadStateAsync()
    {
        _notFound = false;
        try
        {
            // Hydratation via gRPC-Web : c'est l'échange gRPC réellement utilisé par le jeu, pas une démo isolée.
            var reply = await GrpcClient.GetGameStateAsync(new GetGameStateRequest { GameId = GameId.ToString() });
            _state = reply.ToGameStateDto();
        }
        catch (RpcException ex) when (ex.StatusCode == StatusCode.NotFound)
        {
            _notFound = true;
        }
    }

    /// <summary>
    /// Remplace l'état de partie et calcule les succès nouvellement débloqués par différence avec l'état
    /// précédent, pour le toast (docs/adr/0017-systeme-de-succes.md). N'est volontairement pas appelée par
    /// LoadStateAsync (hydratation initiale) : les succès déjà acquis n'ont pas à re-déclencher un toast à
    /// chaque rechargement de la page.
    /// </summary>
    private void UpdateState(GameStateDto newState)
    {
        var previousIds = _state?.Achievements.ToHashSet() ?? [];
        _newlyUnlocked = newState.Achievements.Where(id => !previousIds.Contains(id)).ToList();
        _state = newState;
    }

    private void SetMode(ActionMode mode)
    {
        _mode = mode;
        _moveError = null;
        _selection.Clear();
    }

    /// <summary>Filtre d'ergonomie seulement : la validation qui fait foi reste celle du serveur.</summary>
    private bool CanClick(int row, int column, CellDisplayState state) => _mode switch
    {
        ActionMode.Scan => RadarRules.ZoneFits(new Coordinate(row, column)),
        ActionMode.Torpedo => true,
        ActionMode.AirStrike => WeaponRules.Cells(new WeaponAction.AirStrike(new Coordinate(row, column), _strikeOrientation)) is not null,
        _ => state.IsUnplayed()
    };

    private async Task OnOpponentCellClickAsync((int Row, int Column) cell)
    {
        _moveError = null;

        if (_mode == ActionMode.Shot && IsSalvo)
        {
            // La salve n'est composée que côté client ; elle est envoyée d'un bloc et validée entièrement par le serveur.
            if (!_selection.Remove(cell) && _selection.Count < _state!.Actions.SalvoSize)
                _selection.Add(cell);
            return;
        }

        await RunAsync(_mode switch
        {
            ActionMode.Scan => () => ScanAsync(cell),
            ActionMode.Torpedo => () => PostTurnAsync("torpedoes",
                new TorpedoRequestDto(_torpedoEdge.ToString(), _torpedoEdge is Edge.Left or Edge.Right ? cell.Row : cell.Column)),
            ActionMode.AirStrike => () => PostTurnAsync("airstrikes",
                new AirStrikeRequestDto(cell.Row, cell.Column, _strikeOrientation.ToString())),
            _ => () => PostTurnAsync("shots", new ShotRequestDto(cell.Row, cell.Column))
        });
    }

    /// <summary>Cible via le champ code (ex. "B5") plutôt que via le clic ; appelle le même point d'entrée que la
    /// grille pour rester valide quel que soit le mode (tir, radar, torpille, frappe, sélection de salve).</summary>
    private Task SubmitTargetCodeAsync()
    {
        _moveError = null;
        if (!CellCode.TryParse(_targetCode, _state!.OpponentBoard.Size, out var cell))
        {
            _moveError = $"Code de case invalide : « {_targetCode} » (attendu par ex. B5).";
            return Task.CompletedTask;
        }

        _targetCode = "";
        return OnOpponentCellClickAsync(cell);
    }

    private Task FireSalvoAsync() => RunAsync(FireSalvoGrpcAsync);

    /// <summary>Bloque la grille pendant l'appel : un double-clic ne doit pas envoyer deux coups.</summary>
    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        try
        {
            await action();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Le scan passe par gRPC-Web (docs/adr/0010-radar-grpc-web.md) ; la réponse porte l'état complet de la partie.</summary>
    private async Task ScanAsync((int Row, int Column) origin)
    {
        try
        {
            var reply = await GrpcClient.ScanZoneAsync(new ScanZoneRequest
            {
                GameId = GameId.ToString(),
                Row = origin.Row,
                Column = origin.Column
            });
            UpdateState(reply.State.ToGameStateDto());
        }
        catch (RpcException ex)
        {
            SetMoveErrorFromRpc(ex);
        }
    }

    /// <summary>La salve passe par gRPC-Web (docs/adr/0014-salvo-grpc-web.md) ; le POST /salvos REST reste disponible
    /// pour d'autres clients, mais l'App n'utilise désormais que ce transport pour cette action.</summary>
    private async Task FireSalvoGrpcAsync()
    {
        var request = new PlaySalvoRequest { GameId = GameId.ToString() };
        request.Shots.AddRange(_selection.Select(c => new CoordinateMessage { Row = c.Row, Column = c.Column }));

        try
        {
            var reply = await GrpcClient.PlaySalvoAsync(request);
            UpdateState(reply.State.ToGameStateDto());
            _selection.Clear();
        }
        catch (RpcException ex)
        {
            SetMoveErrorFromRpc(ex);
        }
    }

    private void SetMoveErrorFromRpc(RpcException ex)
    {
        _moveError = ex.StatusCode == StatusCode.FailedPrecondition
            ? $"{MoveErrorMessages.For(ex.Status.Detail)} (gRPC {ex.StatusCode})"
            : $"Erreur gRPC-Web : {ex.StatusCode} — {ex.Status.Detail}";
    }

    private async Task PostTurnAsync<TRequest>(string action, TRequest request)
    {
        var response = await Http.PostAsJsonAsync($"api/games/{GameId}/{action}", request);
        await ApplyMoveResponseAsync(response);
        if (response.StatusCode is HttpStatusCode.OK or HttpStatusCode.Accepted)
            _selection.Clear();
    }

    /// <summary>Voir docs/adr/0019-mini-jeu-de-precision.md : réagit à l'arrêt du curseur signalé par le joueur en résolvant le défi affiché — jamais en lui demandant s'il a gagné.</summary>
    private Task OnChallengeStopAsync()
    {
        var challengeId = _state!.PendingChallenge?.ChallengeId;
        return challengeId is null
            ? Task.CompletedTask
            : RunAsync(async () =>
            {
                var response = await Http.PostAsync($"api/games/{GameId}/challenges/{challengeId}/resolve", content: null);
                await ApplyMoveResponseAsync(response);
            });
    }

    /// <summary>
    /// Commun à toute action de tour, qu'elle se termine (200, TurnResultDto) ou reste en suspens en attendant un
    /// défi de timing (202, GameStateDto complet — y compris les cases déjà résolues plus tôt dans un même lot).
    /// </summary>
    private async Task ApplyMoveResponseAsync(HttpResponseMessage response)
    {
        switch (response.StatusCode)
        {
            case HttpStatusCode.OK:
                var turn = await response.Content.ReadFromJsonAsync<TurnResultDto>();
                if (turn is null)
                {
                    _moveError = "Réponse du serveur inattendue (corps vide ou invalide).";
                    return;
                }

                UpdateState(_state!.Apply(turn));
                break;
            case HttpStatusCode.Accepted:
                var state = await response.Content.ReadFromJsonAsync<GameStateDto>();
                if (state is null)
                {
                    _moveError = "Réponse du serveur inattendue (corps vide ou invalide).";
                    return;
                }

                UpdateState(state);
                break;
            case HttpStatusCode.Conflict:
                var conflict = await response.Content.ReadFromJsonAsync<ConflictBody>();
                _moveError = MoveErrorMessages.For(conflict?.Code);
                break;
            case HttpStatusCode.BadRequest:
                _moveError = "Requête refusée par la validation du serveur (coordonnées ou paramètres invalides).";
                break;
            case HttpStatusCode.NotFound:
                _moveError = "Partie introuvable.";
                break;
            default:
                _moveError = $"Erreur inattendue (HTTP {(int)response.StatusCode}).";
                break;
        }
    }

    /// <summary>Une entrée du journal (TICKET-10) : le coup du joueur puis la riposte, sur le modèle des messages déjà affichés au fil de la partie.</summary>
    private static string DescribeEntry(int turnNumber, JournalEntryDto entry)
    {
        var playerText = entry.PlayerWeapon switch
        {
            nameof(WeaponKind.Torpedo) => $"torpille ({DescribeShots(entry.PlayerShots)})",
            nameof(WeaponKind.AirStrike) => $"frappe aérienne ({DescribeShots(entry.PlayerShots)})",
            _ when entry.PlayerScan is not null =>
                $"scan en ({entry.PlayerScan.Origin.Row},{entry.PlayerScan.Origin.Column}) → {(entry.PlayerScan.ShipDetected ? "navire détecté" : "zone vide")}",
            _ when entry.PlayerShots.Count > 1 => $"salve de {entry.PlayerShots.Count} tirs ({DescribeShots(entry.PlayerShots)})",
            _ => $"tir en ({entry.PlayerShots[0].Target.Row},{entry.PlayerShots[0].Target.Column}) → {DescribeOutcome(entry.PlayerShots[0].Outcome)}"
        };

        var computerText = entry.ComputerWeapon switch
        {
            nameof(WeaponKind.Torpedo) => "torpille",
            nameof(WeaponKind.AirStrike) => "frappe aérienne",
            _ when entry.ComputerShots.Count == 0 => "aucune riposte",
            _ => $"{entry.ComputerShots.Count} tir{(entry.ComputerShots.Count > 1 ? "s" : "")} ({DescribeShots(entry.ComputerShots)})"
        };

        return $"Tour {turnNumber} : {playerText} — riposte : {computerText}.";
    }

    private static string DescribeShots(IReadOnlyList<ShotResultDto> shots)
    {
        var hits = shots.Count(s => s.Outcome != ShotOutcomeDto.Miss);
        return hits == 0 ? "aucun touché" : $"{hits} touché{(hits > 1 ? "s" : "")}";
    }

    private static string DescribeOutcome(ShotOutcomeDto outcome) => outcome switch
    {
        ShotOutcomeDto.Miss => "raté",
        ShotOutcomeDto.Hit => "touché",
        ShotOutcomeDto.Sunk => "coulé",
        _ => outcome.ToString()
    };

    private Task GoHomeAsync()
    {
        Navigation.NavigateTo("/");
        return Task.CompletedTask;
    }

    private sealed record ConflictBody(string? Code);
}
