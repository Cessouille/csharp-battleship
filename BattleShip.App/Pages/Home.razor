@page "/"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject PlayerSession PlayerSession
@using System.Net.Http.Json
@using BattleShip.App.Components
@using BattleShip.App.Game
@using BattleShip.Models.Contracts
@using BattleShip.Models.Domain

<PageTitle>Bataille Navale</PageTitle>

<h1>Bataille Navale</h1>

<p>
    Grille 10×10, flotte classique (porte-avions, croiseur, contre-torpilleur, sous-marin, torpilleur) placée
    aléatoirement. Vous affrontez un ordinateur qui cible les cases les plus probables d'après ce qu'il a déjà
    découvert de votre flotte.
</p>

<fieldset class="mb-3">
    <legend class="h6">Options de la partie</legend>
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="option-salvo" @bind="_salvo" />
        <label class="form-check-label" for="option-salvo">
            Salvo : chaque tour, autant de tirs que de navires encore à flot (vaut aussi pour l'ordinateur)
        </label>
    </div>
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="option-weapons" @bind="_weapons" />
        <label class="form-check-label" for="option-weapons">
            Armes spéciales : @WeaponRules.TorpedoesPerGame torpille et @WeaponRules.AirStrikesPerGame frappe aérienne de @WeaponRules.AirStrikeLength cases par camp, chacune à la place d'un tour
        </label>
    </div>
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="option-radar" @bind="_radar" />
        <label class="form-check-label" for="option-radar">
            Radar : @RadarRules.ScansPerGame scans d'une zone @(RadarRules.ZoneSize)×@(RadarRules.ZoneSize), chacun à la place d'un tir
        </label>
    </div>
</fieldset>

<fieldset class="mb-3">
    <legend class="h6">Difficulté de l'IA</legend>
    <div class="form-check form-check-inline">
        <input class="form-check-input" type="radio" name="ai-difficulty" id="difficulty-easy"
               checked="@(_difficulty == AiDifficulty.Easy)" @onchange="() => _difficulty = AiDifficulty.Easy" />
        <label class="form-check-label" for="difficulty-easy">Facile (tir au hasard)</label>
    </div>
    <div class="form-check form-check-inline">
        <input class="form-check-input" type="radio" name="ai-difficulty" id="difficulty-medium"
               checked="@(_difficulty == AiDifficulty.Medium)" @onchange="() => _difficulty = AiDifficulty.Medium" />
        <label class="form-check-label" for="difficulty-medium">Moyenne (chasse/cible)</label>
    </div>
    <div class="form-check form-check-inline">
        <input class="form-check-input" type="radio" name="ai-difficulty" id="difficulty-hard"
               checked="@(_difficulty == AiDifficulty.Hard)" @onchange="() => _difficulty = AiDifficulty.Hard" />
        <label class="form-check-label" for="difficulty-hard">Difficile (grille de probabilité)</label>
    </div>
</fieldset>

<fieldset class="mb-3">
    <legend class="h6">Placement de votre flotte</legend>
    <div class="form-check form-check-inline">
        <input class="form-check-input" type="radio" name="placement-mode" id="placement-random"
               checked="@(!_manualPlacement)" @onchange="() => SetManualPlacement(false)" />
        <label class="form-check-label" for="placement-random">Aléatoire</label>
    </div>
    <div class="form-check form-check-inline">
        <input class="form-check-input" type="radio" name="placement-mode" id="placement-manual"
               checked="@_manualPlacement" @onchange="() => SetManualPlacement(true)" />
        <label class="form-check-label" for="placement-manual">À la main</label>
    </div>
</fieldset>

@if (_manualPlacement)
{
    <PlacementPanel Model="_placement" OnChanged="StateHasChanged" />
}

<button type="button" class="btn btn-primary" @onclick="StartNewGameAsync"
        disabled="@(_starting || (_manualPlacement && !_placement.IsComplete))">
    @(_starting ? "Création…" : "Nouvelle partie")
</button>

@if (_error is not null)
{
    <div class="alert alert-danger mt-3">@_error</div>
}

@code {
    private bool _starting;
    private bool _radar;
    private bool _salvo;
    private bool _weapons;
    private bool _manualPlacement;
    private AiDifficulty _difficulty = AiDifficulty.Hard;
    private readonly PlacementViewModel _placement = new();
    private string? _error;

    private void SetManualPlacement(bool manual)
    {
        _manualPlacement = manual;
        _placement.Reset();
    }

    private async Task StartNewGameAsync()
    {
        _starting = true;
        _error = null;
        try
        {
            // Obtenu avant la création (TICKET-14) : sinon la toute première partie d'un visiteur ne serait
            // jamais associée à son profil (voir docs/adr/0018-profil-joueur-anonyme.md).
            var playerId = await PlayerSession.GetOrCreatePlayerIdAsync();
            var response = await Http.PostAsJsonAsync("api/games", new CreateGameRequestDto(
                Radar: _radar,
                ShotMode: (_salvo ? ShotMode.Salvo : ShotMode.Classic).ToString(),
                SpecialWeapons: _weapons,
                Placements: _manualPlacement ? _placement.ToPlacementDtos() : null,
                Difficulty: _difficulty.ToString(),
                PlayerId: playerId.ToString()));
            if (!response.IsSuccessStatusCode)
            {
                _error = $"La création de la partie a échoué (HTTP {(int)response.StatusCode}).";
                return;
            }

            var created = await response.Content.ReadFromJsonAsync<CreateGameResponseDto>();
            Navigation.NavigateTo($"/game/{created!.GameId}");
        }
        catch (HttpRequestException ex)
        {
            _error = $"Impossible de joindre l'API : {ex.Message}";
        }
        finally
        {
            _starting = false;
        }
    }
}
