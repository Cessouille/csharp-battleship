<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.AspNetCore.Web" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Déclarées explicitement plutôt que laissées transitives via Grpc.AspNetCore : sans cette ligne,
         la version réellement utilisée ici (protobuf runtime + générateur de code) n'apparaît dans aucun
         .csproj et ne peut plus dériver de celle de BattleShip.App au fil des restaurations séparées. -->
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BattleShip.Models\BattleShip.Models.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- "Both" plutôt que "Server" : le stub client n'est jamais appelé en production, mais permet à
         BattleShip.Tests (qui référence ce projet) de piloter le service en gRPC-Web via WebApplicationFactory
         sans dupliquer la génération protobuf dans un second projet -->
    <Protobuf Include="../Protos/battleship.proto" GrpcServices="Both" Link="Protos/battleship.proto" />
  </ItemGroup>

</Project>
